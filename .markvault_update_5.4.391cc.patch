+    /**
+     * v5.4.391cc — Clear rebuildable MEDIA cache without touching notes,
+     * article embeddings/chunks, playlists, favourites, local media or playback
+     * history/resume rows. Caption files are intentionally a separate action.
+     */
+    fun clearAllMediaCache() {
+        if (clearMediaCacheJob?.isActive == true) return
+        clearMediaCacheJob = viewModelScope.launch(Dispatchers.IO) {
+            try {
+                cancelMediaSemanticIndexing()
+                val protectedIds = LinkedHashSet<Long>()
+                runCatching { playlistDao.getAll() }.getOrDefault(emptyList()).forEach { protectedIds.addAll(it.idList()) }
+
+                val all = ArrayList<com.tebogo.markvault.data.MediaItem>()
+                var offset = 0
+                while (true) {
+                    val page = mediaDao.mediaPage(500, offset)
+                    if (page.isEmpty()) break
+                    all.addAll(page)
+                    offset += page.size
+                }
+                val removable = all.filter { item ->
+                    item.id !in protectedIds && item.isFavourite == 0 && item.lastPlayedAt <= 0L &&
+                        item.resumePositionMs <= 0L && item.localPath.isBlank()
+                }
+                val embeddingCount = runCatching { mediaDao.mediaEmbeddingCount() }.getOrDefault(0)
+                val total = removable.size + embeddingCount + 2 // + image memory + disk cache steps
+                var done = 0
+                _clearMediaCacheProgress.value = CacheDeleteProgress(running = true, total = total, message = "Preparing media cache deletion…")
+
+                // Derived media embeddings are cache only; clear them first in one
+                // transaction-equivalent DAO operation, but advance the visible
+                // progress by their actual row count.
+                runCatching { mediaDao.clearAllMediaEmbeddings() }
+                done += embeddingCount
+                _clearMediaCacheProgress.value = CacheDeleteProgress(true, done, total, "Cleared $embeddingCount derived media embeddings")
+
+                for (item in removable) {
+                    currentCoroutineContext().ensureActive()
+                    mediaDao.delete(item.id)
+                    done++
+                    _clearMediaCacheProgress.value = CacheDeleteProgress(true, done, total, "Clearing media metadata $done / $total • ${item.title.take(48)}")
+                }
+
+                val imageLoader = coil.Coil.imageLoader(getApplication())
+                runCatching { imageLoader.memoryCache?.clear() }
+                done++
+                _clearMediaCacheProgress.value = CacheDeleteProgress(true, done, total, "Cleared image memory cache")
+                runCatching { imageLoader.diskCache?.clear() }
+                done++
+                _globalMediaResults.value = emptyList()
+                _captionVideoResults.value = emptyList()
+                _clearMediaCacheProgress.value = CacheDeleteProgress(false, done, total, "Media cache cleared • user media state preserved", true)
+            } catch (t: Throwable) {
+                if (t is kotlinx.coroutines.CancellationException) throw t
+                _clearMediaCacheProgress.value = _clearMediaCacheProgress.value.copy(running = false, message = "Media cache deletion failed: ${t.message ?: "unknown error"}")
+            } finally { clearMediaCacheJob = null }
+        }
+    }

+    /** v5.4.391cc — Remove downloaded/captured CC and its sidecar only. */
+    fun deleteDownloadedVideoCaptions() {
+        if (deleteCcJob?.isActive == true) return
+        deleteCcJob = viewModelScope.launch(Dispatchers.IO) {
+            val context = getApplication<Application>()
+            try {
+                // Stop every writer/reader first so files cannot be recreated in
+                // the middle of deletion.
+                bulkCaptionDownloadJob?.cancelAndJoin()
+                transcriptExtractionJobs.values.toList().forEach { it.cancelAndJoin() }
+                transcriptExtractionJobs.clear()
+                captionSearchJob?.cancelAndJoin()
+                _captionVideoResults.value = emptyList()
+                _deleteCcProgress.value = CacheDeleteProgress(running = true, message = "Preparing caption deletion…")
+                com.tebogo.markvault.data.VideoTranscriptStore.deleteAll(context) { done, total, current ->
+                    _deleteCcProgress.value = CacheDeleteProgress(
+                        running = true, completed = done, total = total,
+                        message = if (total == 0) "No downloaded CC found" else "Deleting CC $done / $total • ${current.take(52)}"
+                    )
+                }
+                _deleteCcProgress.value = _deleteCcProgress.value.copy(
+                    running = false, completed = _deleteCcProgress.value.total,
+                    message = "Downloaded CC deleted", finished = true
+                )
+            } catch (t: Throwable) {
+                if (t is kotlinx.coroutines.CancellationException) throw t
+                _deleteCcProgress.value = _deleteCcProgress.value.copy(running = false, message = "CC deletion failed: ${t.message ?: "unknown error"}")
+            } finally { deleteCcJob = null }
+        }
+    }

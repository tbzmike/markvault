+    fun settleHtmlHighlightUi(view: WebView, attempt: Int = 0) {
+        view.evaluateJavascript(
+            articleHighlightCountJs(HTML_PRIMARY_HIGHLIGHT_SELECTOR)
+        ) { rawCount ->
+            if (webViewRef !== view) return@evaluateJavascript
+            val count = parseJavascriptInt(rawCount).coerceAtLeast(0)
+            if (count > 0) {
+                highlightMatchCount = count
+                highlightLoading = false
+            } else if (attempt < 2) {
+                // buildHighlightJs has guarded retries at ~400 ms and ~1900 ms
+                // for dynamic/offline pages. Poll just after those windows so
+                // the loading indicator reflects the real DOM outcome rather
+                // than the evaluateJavascript call returning too early.
+                val delayMs = if (attempt == 0) 500L else 1650L
+                view.postDelayed({ settleHtmlHighlightUi(view, attempt + 1) }, delayMs)
+            } else {
+                highlightMatchCount = 0
+                highlightLoading = false
+            }
+        }
+    }

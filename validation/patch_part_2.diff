+/** Returns the number of currently visible primary highlight targets. */
+internal fun articleHighlightCountJs(selector: String): String = """
+    (function(){
+      try {
+        var nodes=document.querySelectorAll(${jsQuoted(selector)}), count=0;
+        for(var i=0;i<nodes.length;i++){
+          var el=nodes[i];
+          if(!el || !el.isConnected) continue;
+          var cs=window.getComputedStyle?window.getComputedStyle(el):null;
+          if(cs && (cs.display==='none' || cs.visibility==='hidden')) continue;
+          var r=el.getBoundingClientRect();
+          if(r.width<=0 && r.height<=0) continue;
+          count++;
+        }
+        if(count<=0) window.__mvHighlightNavIndex=-1;
+        else if(typeof window.__mvHighlightNavIndex!=='number' ||
+                window.__mvHighlightNavIndex<0 ||
+                window.__mvHighlightNavIndex>=count) {
+          // All existing highlighters auto-scroll to the first primary match,
+          // so index zero is the correct starting point for arrow navigation.
+          window.__mvHighlightNavIndex=0;
+        }
+        return count;
+      } catch(e) { return 0; }
+    })()
+""".trimIndent()
+
+/**
+ * Jumps to the previous (-1) or next (+1) primary highlight and returns its
+ * zero-based index. The target list is rebuilt on every tap so semantic
+ * handoff/re-rendering cannot leave stale DOM references behind.
+ */
+internal fun articleHighlightJumpJs(selector: String, direction: Int): String {
+    val step = if (direction < 0) -1 else 1
+    return """
+        (function(){
+          try {
+            var raw=document.querySelectorAll(${jsQuoted(selector)}), nodes=[];
+            for(var i=0;i<raw.length;i++){
+              var el=raw[i];
+              if(!el || !el.isConnected) continue;
+              var cs=window.getComputedStyle?window.getComputedStyle(el):null;
+              if(cs && (cs.display==='none' || cs.visibility==='hidden')) continue;
+              var r=el.getBoundingClientRect();
+              if(r.width<=0 && r.height<=0) continue;
+              nodes.push(el);
+            }
+            if(!nodes.length){window.__mvHighlightNavIndex=-1;return -1;}
+            var idx=window.__mvHighlightNavIndex;
+            if(typeof idx!=='number' || idx<0 || idx>=nodes.length) idx=0;
+            idx=(idx+($step)+nodes.length)%nodes.length;
+            window.__mvHighlightNavIndex=idx;
+            var target=nodes[idx];
+            try{target.scrollIntoView({behavior:'smooth',block:'center'});}
+            catch(e){try{target.scrollIntoView();}catch(_){}}
+            // Brief outline gives feedback without changing/removing the
+            // highlighter's own classes or risking the v5.5.18 handoff fix.
+            var oldOutline=target.style.outline;
+            var oldOffset=target.style.outlineOffset;
+            target.style.outline='2px solid currentColor';
+            target.style.outlineOffset='3px';
+            setTimeout(function(){
+              try{target.style.outline=oldOutline;target.style.outlineOffset=oldOffset;}catch(_){}
+            },650);
+            return idx;
+          } catch(e) { return -1; }
+        })()
+    """.trimIndent()
+}
+
+internal fun parseJavascriptInt(raw: String?): Int =
+    raw?.trim()?.removeSurrounding("\"")?.toIntOrNull() ?: 0
+
+private fun jsQuoted(value: String): String =
+    org.json.JSONObject.quote(value)
